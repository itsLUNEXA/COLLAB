# ==============================================================================
# COLLAB Platform Environment Configuration Template
# Copy to .env and fill in real values. Never commit real secrets to Git.
# ==============================================================================

# Server Network Configuration
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret (minimum 32 characters for secure HMAC-SHA256 signing)
JWT_SECRET=replace-with-a-secure-random-32-char-secret-string

# GitHub App Integration
GITHUB_APP_ID=your_github_app_id
GITHUB_INSTALLATION_ID=your_installation_id
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
GITHUB_REPO_OWNER=your_github_org_or_username
GITHUB_REPO_NAME=your_repository_name

# Dashboard Configuration (Optional overrides)
VITE_API_URL=http://127.0.0.1:4000
VITE_WS_URL=ws://127.0.0.1:4000/ws
