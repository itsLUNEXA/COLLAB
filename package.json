{
  "name": "collab-ai-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collaborative AI Coding Platform for Multi-Developer Workspaces with Antigravity IDE and Contract Guard",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "db:migrate": "node ./scripts/apply-migrations.js",
    "lint": "npm run --workspaces --if-present lint"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
